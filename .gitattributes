# Stable source hash verification across Git for Windows and Linux.
# All shipped source text uses LF even when edited on Windows.
* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.cmake text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
